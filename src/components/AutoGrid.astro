---
import { getCollection } from 'astro:content';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';

const docs = await getCollection('docs');

const metaMap: Record<string, { order: number; icon: string; description: string }> = {
  bash: {
    order: 1,
    icon: 'document',
    description: 'Universal shell scripts, automated media processing with FFmpeg, and portable system utilities.'
  },
  termux: {
    order: 2,
    icon: 'laptop',
    description: 'Mobile task automation, telemetry gathering, and hardware level integrations via Termux:API.'
  },
  powershell: {
    order: 3,
    icon: 'setting',
    description: 'Advanced PowerShell snippets, remote execution security parsing, and fast async network scanners.'
  },
  git: {
    order: 4,
    icon: 'git',
    description: 'Custom repository management workflows, performance tuning, and advanced history rewrites.'
  },
  runbooks: {
    order: 5,
    icon: 'open-book',
    description: 'Operational procedures, content expansion guides, local environment lifecycle, and deployment troubleshooting.'
  }
};

const filteredDocs = docs.filter(doc => doc.id !== 'index.mdx' && doc.id !== 'index');

const grouped = new Map<string, typeof docs>();
for (const doc of filteredDocs) {
  const slug = doc.id.replace(/\.mdx?$/, '');
  const baseSlug = slug.split('/')[0];
  if (!grouped.has(baseSlug)) {
    grouped.set(baseSlug, []);
  }
  grouped.get(baseSlug)!.push(doc);
}

const pages = Array.from(grouped.entries()).map(([baseSlug, group]) => {
  const sorted = [...group].sort((a, b) => {
    const aOrder = a.data.sidebar?.order ?? 999;
    const bOrder = b.data.sidebar?.order ?? 999;
    if (aOrder !== bOrder) return aOrder - bOrder;
    return a.id.localeCompare(b.id);
  });
  const primary = sorted[0];
  const primarySlug = primary.id.replace(/\.mdx?$/, '');
  const meta = metaMap[baseSlug];
  const order = primary.data.sidebar?.order ?? meta?.order ?? 999;
  const icon = primary.data.icon ?? meta?.icon ?? 'document';
  const description = primary.data.description ?? meta?.description ?? 'Collection of scripts and automation workflows.';
  let title = primary.data.title;
  if (baseSlug === 'runbooks') {
    title = 'Runbooks';
  }
  return {
    title,
    description,
    href: `/${primarySlug}/`,
    icon,
    order
  };
}).sort((a, b) => a.order - b.order);
---

<CardGrid stagger>
  {pages.map(page => (
    <LinkCard
      title={page.title}
      description={page.description}
      href={page.href}
      icon={page.icon}
    />
  ))}
</CardGrid>
