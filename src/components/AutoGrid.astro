---
import { getCollection } from 'astro:content';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';

// Fetch all docs
const docs = await getCollection('docs');

// Filter out the homepage and sort pages by sidebar order
const sortedDocs = docs
  .filter(doc => doc.id !== 'index.mdx' && doc.id !== 'index')
  .sort((a, b) => {
    const orderA = a.data.sidebar?.order ?? 999;
    const orderB = b.data.sidebar?.order ?? 999;
    return orderA - orderB;
  });

const pages = sortedDocs.map(doc => {
  const title = doc.data.title;
  const description = doc.data.description || 'Collection of scripts and automation workflows.';
  
  // Starlight generates routes based on the file ID/slug
  const href = `/${doc.id.replace(/\.mdx?$/, '')}/`;
  
  // Retrieve custom icon from frontmatter, defaulting to document
  const icon = doc.data.icon || 'document';
  
  return { title, description, href, icon };
});
---

<CardGrid stagger>
  {pages.map(page => (
    <LinkCard
      title={page.title}
      description={page.description}
      href={page.href}
      icon={page.icon}
    />
  ))}
</CardGrid>
