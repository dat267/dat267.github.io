---
---

<div class="app not-content">
  <label class="field">
    <span>OpenAPI spec (YAML or JSON)</span>
    <textarea id="otc-input" class="tall" spellcheck="false" placeholder={'Paste an OpenAPI 3.x spec here. Accepts YAML or JSON.'}></textarea>
  </label>

  <div class="toolbar">
    <div class="toolbar-row">
      <select id="otc-target" aria-label="Target language">
        <option value="typescript">TypeScript</option>
        <option value="javascript">JavaScript</option>
        <option value="go">Go</option>
        <option value="python">Python</option>
        <option value="rust">Rust (reqwest)</option>
        <option value="powershell">PowerShell</option>
      </select>
    </div>
    <div class="toolbar-row">
      <button id="otc-convert" class="primary" type="button">Convert</button>
    </div>
  </div>

  <p id="otc-warnings" class="warn" hidden></p>
  <p id="otc-error" class="error" hidden></p>

  <div class="output-block">
    <button id="otc-copy" class="code-copy" type="button" title="Copy code" aria-label="Copy code">
      <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
      <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden><path d="M20 6 9 17l-5-5"></path></svg>
    </button>
    <div id="otc-output" class="output" data-placeholder="Paste an OpenAPI spec and click Convert."></div>
  </div>
</div>

<script>
  import { generateClient } from "../scripts/openapi-client/generate.ts";
  import type { ClientTarget } from "../scripts/openapi-client/generate.ts";
  import { highlight } from "../scripts/highlight.ts";

  const LANG: Record<string, string> = {
    typescript: "typescript",
    javascript: "javascript",
    go: "go",
    python: "python",
    rust: "rust",
    powershell: "powershell",
  };

  const input = document.querySelector<HTMLTextAreaElement>("#otc-input")!;
  const target = document.querySelector<HTMLSelectElement>("#otc-target")!;
  const convert = document.querySelector<HTMLButtonElement>("#otc-convert")!;
  const copy = document.querySelector<HTMLButtonElement>("#otc-copy")!;
  const copyIcon = copy.querySelector<SVGElement>(".copy-icon")!;
  const checkIcon = copy.querySelector<SVGElement>(".check-icon")!;
  const output = document.querySelector<HTMLDivElement>("#otc-output")!;
  const error = document.querySelector<HTMLElement>("#otc-error")!;
  const warnings = document.querySelector<HTMLElement>("#otc-warnings")!;

  async function render() {
    const text = input.value.trim();
    if (!text) {
      output.textContent = "";
      output.dataset.placeholder = "Paste an OpenAPI spec and click Convert.";
      error.hidden = true;
      warnings.hidden = true;
      return;
    }
    try {
      const result = generateClient(text, target.value as ClientTarget);
      output.innerHTML = await highlight(result.code, LANG[target.value] ?? "typescript");
      error.hidden = true;
      if (result.warnings.length) {
        warnings.textContent = "Warnings: " + result.warnings.join(" | ");
        warnings.hidden = false;
      } else {
        warnings.hidden = true;
      }
    } catch (err) {
      output.textContent = "";
      output.dataset.placeholder = "Fix the error above to see generated code.";
      error.textContent = err instanceof Error ? err.message : String(err);
      error.hidden = false;
      warnings.hidden = true;
    }
  }

  convert.addEventListener("click", render);
  input.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "Enter") render();
  });

  copy.addEventListener("click", async () => {
    const text = output.querySelector("code")?.textContent ?? "";
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyIcon.hidden = true;
      checkIcon.hidden = false;
      window.setTimeout(() => {
        copyIcon.hidden = false;
        checkIcon.hidden = true;
      }, 1500);
    } catch {
      // leave the icon unchanged
    }
  });

  render();
</script>
