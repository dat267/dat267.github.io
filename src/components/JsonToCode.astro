---
---

<div class="app not-content">
  <label class="field">
    <span>JSON sample</span>
    <textarea id="j2c-input" class="tall" spellcheck="false" placeholder={'{"name":"Jane","age":30,"active":true,"tags":["a"],"meta":{"ok":true}}'}></textarea>
  </label>

  <div class="toolbar">
    <div class="toolbar-row">
      <select id="j2c-target" aria-label="Target language">
        <option value="typescript">TypeScript</option>
        <option value="go">Go</option>
        <option value="python">Python</option>
        <option value="rust">Rust</option>
        <option value="json-schema">JSON Schema</option>
      </select>
      <input id="j2c-root" type="text" value="Root" aria-label="Root type name" />
    </div>
  </div>

  <p id="j2c-error" class="error" hidden></p>

  <div class="output-block">
    <div class="copy">
      <button id="j2c-copy" type="button" title="Copy to clipboard" aria-label="Copy to clipboard">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 19a2 2 0 0 1-1-2V2a2 2 0 0 1 1-1h13a2 2 0 0 1 2 1"></path><rect x="6" y="5" width="16" height="18" rx="1.5" ry="1.5"></rect></svg>
      </button>
      <span aria-live="polite" role="status"></span>
    </div>
    <div id="j2c-output" class="output" data-placeholder="Paste JSON above to generate typed code."></div>
  </div>
</div>

<script>
  import { generateCode } from "../scripts/json-code/generate.ts";
  import type { Target } from "../scripts/json-code/generate.ts";
  import { highlight } from "../scripts/highlight.ts";

  const LANG: Record<string, string> = {
    typescript: "typescript",
    go: "go",
    python: "python",
    rust: "rust",
    "json-schema": "json",
  };

  const input = document.querySelector<HTMLTextAreaElement>("#j2c-input")!;
  const target = document.querySelector<HTMLSelectElement>("#j2c-target")!;
  const root = document.querySelector<HTMLInputElement>("#j2c-root")!;
  const output = document.querySelector<HTMLDivElement>("#j2c-output")!;
  const error = document.querySelector<HTMLElement>("#j2c-error")!;
  const copy = document.querySelector<HTMLButtonElement>("#j2c-copy")!;
  const live = copy.parentElement?.querySelector<HTMLElement>("[aria-live]")!;

  function showFeedback() {
    const feedback = document.createElement("div");
    feedback.className = "feedback";
    feedback.textContent = "Copied!";
    live.replaceChildren(feedback);
    requestAnimationFrame(() => feedback.classList.add("show"));
    window.setTimeout(() => {
      feedback.classList.remove("show");
      window.setTimeout(() => feedback.remove(), 250);
    }, 1500);
  }

  async function render() {
    const text = input.value.trim();
    if (!text) {
      output.textContent = "";
      output.dataset.placeholder = "Paste JSON above to generate typed code.";
      error.hidden = true;
      return;
    }
    try {
      const code = generateCode(text, target.value as Target, root.value.trim() || "Root");
      output.innerHTML = await highlight(code, LANG[target.value] ?? "typescript");
      error.hidden = true;
    } catch (err) {
      output.textContent = "";
      output.dataset.placeholder = "Fix the error above to see generated code.";
      error.textContent = err instanceof Error ? err.message : String(err);
      error.hidden = false;
    }
  }

  let timer = 0;
  input.addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(render, 200);
  });
  root.addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(render, 200);
  });
  target.addEventListener("change", render);

  copy.addEventListener("click", async () => {
    const text = output.querySelector("code")?.textContent ?? "";
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // clipboard unavailable; keep the icon unchanged
    }
    showFeedback();
  });

  render();
</script>
